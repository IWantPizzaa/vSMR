root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,h,hpp,rc}]
indent_style = tab
indent_size = 4
tab_width = 4

[*.{json,yml,yaml,js,css,html,md,props,targets,vcxproj}]
indent_style = space
indent_size = 2

[*.ps1]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
