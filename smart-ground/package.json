{
  "name": "smart-ground-lfpg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "pretest": "npm run build",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "validate": "tsx scripts/validate.ts",
    "validate:operations": "tsx scripts/validate-operations.ts",
    "validate:flows": "tsx scripts/validate-flows.ts",
    "validate:route-quality": "tsx scripts/validate-route-quality.ts",
    "validate:aircraft": "tsx scripts/validate-aircraft-restrictions.ts",
    "validate:traffic": "tsx scripts/validate-traffic.ts",
    "validate:surveillance": "tsx scripts/validate-surveillance.ts",
    "validate:replays": "tsx scripts/validate-replays.ts"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
