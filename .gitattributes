# Auto detect text files and perform LF normalization
* text=auto

# Canonical release data is serialized with LF regardless of Windows Git settings.
vSMR/data/vSMR_Profiles.json text eol=lf
vSMR/data/ICAO_Aircraft.json text eol=lf
vSMR/data/AVISO/*.geojson text eol=lf

# Custom for Visual Studio
*.cs     diff=csharp

# Standard to msysgit
*.doc	 diff=astextplain
*.DOC	 diff=astextplain
*.docx diff=astextplain
*.DOCX diff=astextplain
*.dot  diff=astextplain
*.DOT  diff=astextplain
*.pdf  diff=astextplain
*.PDF	 diff=astextplain
*.rtf	 diff=astextplain
*.RTF	 diff=astextplain

# Preserve CRLF in the upstream RDF patch because that repository tracks the
# target source file with CRLF bytes and git apply matches those bytes exactly.
vSMR/data/Tools/RDF-vSMR-ground-view.patch -text whitespace=cr-at-eol,-space-before-tab
