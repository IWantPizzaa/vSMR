#include <windows.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,0,0,2
 PRODUCTVERSION 2,0,0,2
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG | VS_FF_PRERELEASE
#else
 FILEFLAGS VS_FF_PRERELEASE
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "vSMR contributors"
            VALUE "FileDescription", "vSMR out-of-process WER crash handler"
            VALUE "FileVersion", "2.0.0-beta.2"
            VALUE "InternalName", "vSMRCrashHandler.dll"
            VALUE "LegalCopyright", "GNU General Public License version 3"
            VALUE "OriginalFilename", "vSMRCrashHandler.dll"
            VALUE "ProductName", "vSMR"
            VALUE "ProductVersion", "2.0.0-beta.2"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
