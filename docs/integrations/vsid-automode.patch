+	// Publish actual airport settings each timer tick, including changes made by
+	// commands, reloads and controller coordination. Command receipt is not state.
+	if (bridgeApi_ != nullptr && bridgeProvider_ != nullptr)
+	{
+		std::string automaticModes;
+		bool validSnapshot = true;
+		for (const auto& [icao, airport] : this->activeAirports)
+		{
+			const auto mode = airport.settings.find("auto");
+			if (mode == airport.settings.end()) continue;
+			if (icao.size() != 4 || !std::all_of(icao.begin(), icao.end(), [](char ch) {
+				return (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9');
+			}) || automaticModes.size() + 7 > 4096)
+			{
+				validSnapshot = false;
+				break;
+			}
+			automaticModes += icao;
+			automaticModes += mode->second ? "=1;" : "=0;";
+		}
+		if (validSnapshot)
+		{
+			const ESB_Value value = ESB_Str(automaticModes.c_str());
+			bridgeApi_->set_global(bridgeProvider_, bridgeAutomaticModeField_, &value);
+		}
+		else bridgeApi_->clear_global(bridgeProvider_, bridgeAutomaticModeField_);
+	}
+
